# Discord Bot Token (Lấy từ Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Lavalink Server URI & Password
# Khi chạy với Docker Compose, hostname là tên container 'lavalink'
LAVALINK_URI=http://lavalink:2333
# Khi chạy Python bot trực tiếp trên máy chủ (không qua Docker), đổi thành:
# LAVALINK_URI=http://localhost:2333

LAVALINK_PASSWORD=youshallnotpass
